---
type GlossaryItemData = {
    id: string;
    term: string;
    definition: string;
};

type Props = {
    items: GlossaryItemData[];
};

const { items } = Astro.props;
---

<ul class="flex flex-col gap-3">
    {items.map((item) => (
        <li class="bg-white rounded-xl border-2 border-sc-light px-6 py-4 flex flex-col gap-1">
            <span class="text-sc-navy font-lexend font-bold text-lg"> {item.term}</span>
            <span class="text-sc-darkest text-base leading-snug">{item.definition}</span>
        </li>
    ))}
</ul>