---
import { supabase } from '../../lib/supabase';
import { YouTube } from '@astro-community/astro-embed-youtube';
import Checklist from '../../components/Checklist';
import Glossary from '../../components/Glossary.astro';
import PracticeScenario from '../../components/PracticeScenario';
import ZoomJoinCall from '../../components/simulations/ZoomJoinCall';
import ScamFraudSim from '../../components/simulations/ScamFraudSim';
import ClientLoad from '../../components/ClientLoad';

const { id } = Astro.params;

const { data: topic, error: topicError } = await supabase
  .from('topics')
  .select(`
    id,
    title,
    description,
    modules (
      id,
      type,
      title,
      order_index
    )
  `)
  .eq('id', id)
  .single();

if (topicError) {
  console.error('error loading topic:', topicError);
}

const checklistModule = topic?.modules?.find((m) => m.type === 'checklist');

let checklistItems = [];
if (checklistModule) {
  const { data, error: itemsError } = await supabase
    .from('checklist_items')
    .select('*')
    .eq('module_id', checklistModule.id)
    .order('order_index', { ascending: true });

  if (itemsError) {
    console.error('Error loading checklist items:', itemsError);
  } else {
    checklistItems = data;
  }
}

const glossaryModule = topic?.modules?.find((m) => m.type === 'glossary');

let glossaryItems = [];
if (glossaryModule) {
  const { data, error: itemsError } = await supabase
    .from('glossary_items')
    .select('*')
    .eq('module_id', glossaryModule.id)
    .order('order_index', { ascending: true });

  if (itemsError) {
    console.error('error loading glossary items:', itemsError);
  } else {
    glossaryItems = data;
  }
}

const practiceScenarioModule = topic?.modules?.find((m) => m.type === 'quiz');

let questions = [];
if (practiceScenarioModule) {
  const { data, error: itemsError } = await supabase
    .from('quiz_questions')
    .select('*, quiz_options(*)')
    .eq('module_id', practiceScenarioModule.id)
    .order('order_index', { ascending: true });

  if (itemsError) {
    console.error('error loading quiz items:', itemsError);
  } else {
    questions = data;
  }
}

const simulationModule = topic?.modules?.find((m) => m.type === 'simulation');

---
<div class="flex flex-col items-center w-full px-8 py-8">
  <h1>{topic?.title}</h1>
  <p>{topic?.description}</p>
  <a href={`/`}>Home</a>
  <br />
  <div class="w-full max-w-2xl">
    <YouTube id="5gfhbjug9rI"/>
  </div>

  <iframe src="https://docs.google.com/presentation/d/e/2PACX-1vTzlK2aTukIU14k99LGKLkYNHvwXxw-PDx752Y0YbGRKaC0ADEiqdurgGHjQZiPXUxLjgbfkfj9xYmh/pubembed?start=false&loop=false&delayms=60000" width="960" height="540" allowfullscreen="true"></iframe>
  
  {checklistModule && (
    <div class="w-full max-w-2xl">
    <h2 class="font-bold">{checklistModule.title}</h2>
    <Checklist items={checklistItems} client:load />
  </div>
  <br />
  )}

  {glossaryModule && (
    <div class="w-full max-w-2xl">
      <h2 class="font-bold">{glossaryModule.title}</h2>
      <Glossary items={glossaryItems} />
    </div>
    <br />
  )}

  {practiceScenarioModule && (
    <div class="w-full max-w-2xl">
      <h2 class="font-bold">{practiceScenarioModule.title}</h2>
      <PracticeScenario questions={questions} client:load />
    </div>
    <br />
  )}

  {simulationModule && (
    <div class="flex flex-col items-center w-full">
      <h2 class="font-bold">{simulationModule.title}</h2>
      {id === '1' && <ZoomJoinCall client:load/>}
      {id === '2' && <ScamFraudSim client:load/>}
    </div>
    <br />
  )}
</div>

