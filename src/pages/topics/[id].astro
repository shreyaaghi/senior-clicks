---
import { supabase } from '../../lib/supabase';
import { YouTube } from '@astro-community/astro-embed-youtube';
import Checklist from '../../components/Checklist';
import Glossary from '../../components/Glossary.astro';
import PracticeScenario from '../../components/PracticeScenario';
import ZoomJoinCall from '../../components/simulations/ZoomJoinCall';
import ScamFraudSim from '../../components/simulations/ScamFraudSim';
import Layout from '../../layouts/Layout.astro';

const { id } = Astro.params;

const { data: topic, error: topicError } = await supabase
  .from('topics')
  .select(`
    id,
    title,
    description,
    modules (
      id,
      type,
      title,
      order_index
    )
  `)
  .eq('id', id)
  .single();

if (topicError) {
  console.error('error loading topic:', topicError);
}

const checklistModule = topic?.modules?.find((m) => m.type === 'checklist');

let checklistItems = [];
if (checklistModule) {
  const { data, error: itemsError } = await supabase
    .from('checklist_items')
    .select('*')
    .eq('module_id', checklistModule.id)
    .order('order_index', { ascending: true });

  if (itemsError) {
    console.error('Error loading checklist items:', itemsError);
  } else {
    checklistItems = data;
  }
}

const glossaryModule = topic?.modules?.find((m) => m.type === 'glossary');

let glossaryItems = [];
if (glossaryModule) {
  const { data, error: itemsError } = await supabase
    .from('glossary_items')
    .select('*')
    .eq('module_id', glossaryModule.id)
    .order('order_index', { ascending: true });

  if (itemsError) {
    console.error('error loading glossary items:', itemsError);
  } else {
    glossaryItems = data;
  }
}

const practiceScenarioModule = topic?.modules?.find((m) => m.type === 'quiz');

let questions = [];
if (practiceScenarioModule) {
  const { data, error: itemsError } = await supabase
    .from('quiz_questions')
    .select('*, quiz_options(*)')
    .eq('module_id', practiceScenarioModule.id)
    .order('order_index', { ascending: true });

  if (itemsError) {
    console.error('error loading quiz items:', itemsError);
  } else {
    questions = data;
  }
}

const simulationModule = topic?.modules?.find((m) => m.type === 'simulation');

---
<Layout title={topic?.title ?? 'Senior Clicks'}>

  <section class="bg-sc-navy px-8 py-16 text-center">
    <h1 class="text-white font-lexend text-4xl font-bold mb-3">
      {topic?.title}
    </h1>
    <p class="text-sc-periwinkle text-lg max-w-xl mx-auto">
      {topic?.description}
    </p>
  </section>

  <div class="max-w-3xl mx-auto px-8 py-12 flex flex-col gap-12">
    <section class="flex flex-col gap-6">
      <h2 class="text-sc-navy font-lexend font-bold text-2xl">Workshop Recording & Slides</h2>
      
      <div class="flex flex-col gap-2">
        <p class="text-sc-dark text-md font-semibold">Recording</p>
        {id === '1' && <YouTube id="5gfhbjug9rI" />}
        {id === '2' && <YouTube id="5gfhbjug9rI" />}
        {id === '3' && <YouTube id="5gfhbjug9rI" />}
        {id === '4' && <YouTube id="5gfhbjug9rI" />}
      </div>
    
      <div class="flex flex-col gap-2">
        <p class="text-sc-dark text-md font-semibold">Slides</p>
        {id === '1' && (
          <iframe
            src="https://docs.google.com/presentation/d/e/2PACX-1vT4dDW7RFCohGZiuPnNeSrYZvJlpwzhRtS4B9ByS1jBJbGH7Rt3JxRMxmM4GO4nqlVAsC9Htdf6D9RI/pubembed?start=false&loop=false&delayms=60000"
            width="100%"
            height="480"
            allowfullscreen="true"
            class="rounded-xl border border-sc-light"
          />
        )}
        {id === '2' && (
          <iframe
            src="https://docs.google.com/presentation/d/e/2PACX-1vTzlK2aTukIU14k99LGKLkYNHvwXxw-PDx752Y0YbGRKaC0ADEiqdurgGHjQZiPXUxLjgbfkfj9xYmh/pubembed?start=false&loop=false&delayms=60000"
            width="100%"
            height="480"
            allowfullscreen="true"
            class="rounded-xl border border-sc-light"
          />
        )}
        {id === '3' && (
          <iframe
            src="https://docs.google.com/presentation/d/e/2PACX-1vTzlK2aTukIU14k99LGKLkYNHvwXxw-PDx752Y0YbGRKaC0ADEiqdurgGHjQZiPXUxLjgbfkfj9xYmh/pubembed?start=false&loop=false&delayms=60000"
            width="100%"
            height="480"
            allowfullscreen="true"
            class="rounded-xl border border-sc-light"
          />
        )}
        {id === '4' && (
          <iframe
            src="https://docs.google.com/presentation/d/e/2PACX-1vSz974RWQJE_0PntSAIqCJ6WFQlJO2IK3hBSvGJDxm1BjbD-cSYWFdMAeRxZoFQDD_yOzb7Dl9wu0hh/pubembed?start=false&loop=false&delayms=60000"
            width="100%"
            height="480"
            allowfullscreen="true"
            class="rounded-xl border border-sc-light"
          />
        )}
      </div>
    </section>

    {checklistModule && (
      <section class="bg-white rounded-2xl border border-sc-light p-8 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="bg-sc-navy text-white font-lexend font-bold text-sm px-3 py-1 rounded-full">
            Step 1
          </span>
          <h2 class="text-sc-navy font-lexend font-bold text-2xl">{checklistModule.title}</h2>
        </div>
        <p class="text-sc-gray text-sm">Work through this checklist before your first call.</p>
        <Checklist items={checklistItems} client:load />
      </section>
    )}

    {glossaryModule && (
      <section class="bg-sc-light rounded-2xl border border-sc-light p-8 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="bg-sc-navy text-white font-lexend font-bold text-sm px-3 py-1 rounded-full">
            Step 2
          </span>
          <h2 class="text-sc-navy font-lexend font-bold text-2xl">{glossaryModule.title}</h2>
        </div>
        <p class="text-sc-gray text-sm">Familiarize yourself with these key terms before getting started.</p>
        <Glossary items={glossaryItems} />
      </section>
    )}

    {practiceScenarioModule && (
      <section class="bg-white rounded-2xl border border-sc-light p-8 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <span class="bg-sc-navy text-white font-lexend font-bold text-sm px-3 py-1 rounded-full">
            Step 3
          </span>
          <h2 class="text-sc-navy font-lexend font-bold text-2xl">{practiceScenarioModule.title}</h2>
        </div>
        <p class="text-sc-gray text-sm">Test what you know with these low-stakes practice questions.</p>
        <PracticeScenario questions={questions} client:load />
      </section>
    )}

    {simulationModule && (
      <section class="bg-sc-light rounded-2xl border border-sc-light p-8 flex flex-col gap-6 items-center">
        <div class="flex items-center gap-3 w-full">
          <span class="bg-sc-navy text-white font-lexend font-bold text-sm px-3 py-1 rounded-full">
            Step 4
          </span>
          <h2 class="text-sc-navy font-lexend font-bold text-2xl">{simulationModule.title}</h2>
        </div>
        <p class="text-sc-gray text-sm w-full">Practice the real thing in a safe, guided environment.</p>
        {id === '1' && <ZoomJoinCall client:load />}
        {id === '2' && <ScamFraudSim client:load />}
      </section>
    )}

  </div>
</Layout>
