---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

let submitted = false;
let errorMessage = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const name = formData.get('name')?.toString() ?? '';
  const email = formData.get('email')?.toString() ?? '';
  const message = formData.get('message')?.toString() ?? '';

  const { error } = await supabase
    .from('contact_messages')
    .insert({ name, email, message });

  if (error) {
    errorMessage = 'Something went wrong. Please try again.';
  } else {
    submitted = true;
  }
}
---

<Layout title="Contact — Senior Clicks">
  <section class="bg-sc-navy px-8 py-16 text-center">
    <h1 class="text-white font-lexend text-4xl font-bold mb-3">
      Get In Touch
    </h1>
    <p class="text-sc-periwinkle text-xl max-w-xl mx-auto">
        Whether you're a senior looking to learn or an organization interested in hosting a workshop, we'd love to hear from you.
    </p>
  </section>

  <div class="max-w-xl mx-auto px-8 py-16">
    {submitted ? (
      <div class="bg-green-50 border border-green-200 rounded-2xl px-8 py-10 text-center">
        <p class="text-green-800 font-lexend font-bold text-2xl mb-2">Message sent!</p>
        <p class="text-green-700">Thanks for reaching out. I'll get back to you within a few days.</p>
      </div>
    ) : (
      <form method="POST" class="flex flex-col gap-6">
        {errorMessage && (
          <p class="text-red-600 text-sm">{errorMessage}</p>
        )}

        <div class="flex flex-col gap-2">
          <label class="text-sc-darkest font-semibold text-lg" for="name">Your name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="border-2 border-sc-light rounded-xl px-4 py-3 text-lg focus:outline-none focus:border-sc-navy"
            placeholder="Jane Smith"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sc-darkest font-semibold text-lg" for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="border-2 border-sc-light rounded-xl px-4 py-3 text-lg focus:outline-none focus:border-sc-navy"
            placeholder="jane@example.com"
          />
        </div>

        <div class="flex flex-col gap-2">
          <label class="text-sc-darkest font-semibold text-lg" for="message">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="border-2 border-sc-light rounded-xl px-4 py-3 text-lg focus:outline-none focus:border-sc-navy resize-none"
            placeholder="Tell me about yourself or what you're looking for..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="bg-sc-navy text-white font-lexend font-bold text-lg px-8 py-4 rounded-xl hover:bg-sc-dark transition-colors"
        >
          Send Message
        </button>
      </form>
    )}
  </div>
</Layout>