---
import { supabase } from "../lib/supabase";
import Layout from "../layouts/Layout.astro";

const { data: topics, error } = await supabase.from("topics").select("*");

if (error) {
	console.error("error:", error);
}
---

<Layout title="Senior Clicks">
	<section class="bg-sc-navy px-8 py-20 flex flex-col items-center text-center gap-6">
	  <h1 class="text-white text-5xl font-lexend font-bold max-w-2xl leading-tight">
		Building confidence, one click at a time.
	  </h1>
	  <p class="text-sc-periwinkle text-xl max-w-xl">
		Free workshops and interactive guides designed for seniors.
	  </p>
  
	  <div class="mt-4 flex flex-col items-center gap-4 max-w-xl w-full">
		<p class="text-sc-light text-base">
		  Senior Clicks offers free, in-person technology workshops at libraries and senior centers across the Bay Area.
		</p>
	  </div>
	</section>
  
	<section class="px-8 py-16 max-w-5xl mx-auto">
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-10 items-center">
			<img
			  src="../public/images/workshop-image.jpg"
			  alt="Senior Clicks workshop participants at a community center"
			  class="rounded-2xl w-full h-72 object-cover"
			/>
			<div class="flex flex-col gap-4">
			  <h2 class="text-sc-navy font-lexend font-bold text-3xl">Our Mission</h2>
			  <p class="text-sc-darkest text-lg leading-relaxed">
				Senior Clicks equips seniors with the tools they need to utilize technology in their daily lives, improving independence, connections with friends and family, and promoting overall well-being. 
			  </p>
			  <p class="text-sc-dark text-base leading-relaxed">
				Weekly classes guide seniors from smartphone basics to modern skills like scam prevention, rideshare apps, and AI literacy, building not just the skills for today, but the lasting confidence to adapt to future digital change.
			  </p>
			  <a href="/contact" class="self-start bg-sc-navy text-white font-lexend font-semibold px-6 py-3 rounded-xl hover:bg-sc-dark transition-colors text-base">
				Partner with us or get in touch →
			  </a>
			</div>
		  </div>
		
		<h2 class="text-sc-navy font-lexend font-bold text-3xl mb-8">
		  Workshop Topics
		</h2>
	  
		{topics == null ? (
		  <p class="text-sc-gray">No topics available yet.</p>
		) : (
		  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6">
			{topics.map((topic) => (
			  <li key={topic.id}>
				<a href={`/topics/${topic.id}`} class="block bg-sc-light rounded-xl p-6 hover:bg-sc-periwinkle transition-colors">
				  <h3 class="text-sc-navy font-lexend font-semibold text-xl mb-2">
					{topic.title}
				  </h3>
				  <p class="text-sc-dark text-sm">
					{topic.description}
				  </p>
				</a>
			  </li>
			))}
		  </ul>
		)}
	  </section>
  </Layout>
